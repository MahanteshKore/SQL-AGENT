```dockerfile
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app

COPY pom.xml .
COPY src ./src

RUN mvn clean package -DskipTests

# Display static resources packaged in the JAR
RUN echo "=== Checking packaged static files ===" && \
    jar tf target/*.jar | grep -E 'BOOT-INF/classes/(static|public)/' || true

FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build /app/target/*.jar app.jar

EXPOSE 8080

CMD ["java", "-jar", "app.jar"]
```
